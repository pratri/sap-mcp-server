# -----------------------------------------------------------------------
# Copy this file to ".env" (same folder) and fill in your real values.
#
# This template is the ONLY one of the two files that is safe to share.
# Never put a real password in here — this file is meant to be committed
# and emailed, and anything written below travels with it.
#
# DO NOT email, commit to git, or otherwise share the real ".env" file.
# -----------------------------------------------------------------------

# Full base URL of your S/4HANA host, including protocol and port.
#
# Prefer https. With http, Basic Auth credentials are sent base64-encoded,
# which is trivially reversible — treat that as sending them in the clear,
# and only do it on a network you trust end to end.
SAP_HOST=https://your-s4hana-host.example.com:50000

# SAP user with read access to the OData services you plan to call.
SAP_USER=REPLACE_ME

# SAP password for the above user.
SAP_PASS=REPLACE_ME

# Optional. Uncomment if your system requires an explicit client number —
# it is then sent as sap-client on every request the server makes.
# SAP_CLIENT=100
